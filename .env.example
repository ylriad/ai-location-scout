# ── API Keys ──────────────────────────────────────────────────────────────────
# Google Maps API key (required for real traffic scores)
# Get one at: https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=

# Anthropic Claude API key (required for AI-generated reports)
# Get one at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# 2GIS Catalog API key (geocoding, competitors, business density)
# Get one at: https://dev.2gis.com/
TWOGIS_API_KEY=

# Apify token (HeadHunter candidate search)
APIFY_API_TOKEN=

# Secret for signing login cookies (any long random string)
JWT_SECRET=

# ── Claude Model ──────────────────────────────────────────────────────────────
# Any current Claude model id, e.g. claude-sonnet-5-5
CLAUDE_MODEL=claude-sonnet-5-5

# ── App Settings ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# Optional hh.ru application token (vacancy API works without it)
HH_APP_TOKEN=
# hh.ru client identification: "AppName/1.0 (your contact e-mail)"
HH_USER_AGENT=
